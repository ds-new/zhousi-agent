# Control Plane auth is required by default. Generate distinct random values.
DIY_PLATFORM_ADMIN_KEY=
DIY_SERVICE_ACCOUNT_TOKEN=
DIY_DATA_PLANE_INTERNAL_TOKEN=
DIY_EVOLUTION_INTERNAL_TOKEN=
DIY_CONTROL_PLANE_PORT=9878
DIY_DATA_PLANE_PORT=3080
DIY_DATA_PLANE_URL=http://127.0.0.1:3080
DIY_CONTROL_PLANE_URL=http://127.0.0.1:9878
DIY_EVOLUTION_URL=http://127.0.0.1:9880
DIY_MODEL_ALLOWED_ORIGINS=https://api.deepseek.com,https://api.openai.com
DIY_DATA_DIRECTORY=.diy-data
# Encryption master material for customer-local vault files; keep out of source control.
DIY_VAULT_KEY_MATERIAL=
# Disabled until golden tasks, approved MCPs and model credentials are configured.
DIY_EVOLUTION_INTERVAL_MS=0
# Explicit local-only bypass (never use on an exposed server):
# DIY_ALLOW_INSECURE_DEV=true

# Postgres (optional — omit for in-memory mode)
# DATABASE_URL=postgres://diy:diy@127.0.0.1:5432/diy_agent

# Production webhooks default to deny-all; operator-approved exact origins only.
DIY_WEBHOOK_ALLOWED_ORIGINS=
